<!-- SUCCESS PAGE -->
<% layout('layout/boilerplate.ejs') -%>
<%
    const dashboardLink = user && user.role !== 'admin' ? `/${user.role}/dashboard` : '/';
%>

<style>
    .success-page {
        background:
            radial-gradient(circle at top left, rgba(118, 186, 214, 0.2), transparent 32%),
            radial-gradient(circle at bottom right, rgba(112, 170, 141, 0.18), transparent 26%),
            linear-gradient(180deg, #f5fafc 0%, #ebf4f7 100%);
        min-height: 100vh;
        overflow: hidden;
        padding: 2rem 0 4rem;
        position: relative;
    }

    .success-page::before,
    .success-page::after {
        border-radius: 50%;
        content: '';
        position: absolute;
        z-index: 0;
    }

    .success-page::before {
        background: rgba(96, 159, 190, 0.12);
        height: 18rem;
        left: -5rem;
        top: 4rem;
        width: 18rem;
    }

    .success-page::after {
        background: rgba(93, 163, 129, 0.12);
        bottom: 3rem;
        height: 14rem;
        right: -3rem;
        width: 14rem;
    }

    .success-shell {
        position: relative;
        z-index: 1;
    }

    .success-card {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(76, 134, 168, 0.14);
        border-radius: 2rem;
        box-shadow: 0 1.6rem 3.2rem rgba(31, 56, 88, 0.12);
        overflow: hidden;
    }

    .success-grid {
        align-items: stretch;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    }

    .success-copy {
        padding: 3rem;
    }

    .success-eyebrow {
        color: #4c86a8;
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .success-title {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 4vw, 3.4rem);
        font-style: italic;
        line-height: 1.02;
        margin-bottom: 1rem;
    }

    .success-message {
        color: #587082;
        font-size: 1.02rem;
        line-height: 1.75;
        margin-bottom: 1.5rem;
        max-width: 40rem;
    }

    .success-points {
        display: grid;
        gap: 0.9rem;
        margin-bottom: 1.8rem;
    }

    .success-point {
        align-items: center;
        color: #24445b;
        display: flex;
        gap: 0.85rem;
    }

    .success-point i {
        align-items: center;
        background: rgba(70, 167, 115, 0.12);
        border-radius: 999px;
        color: #2f8c5b;
        display: inline-flex;
        height: 2.1rem;
        justify-content: center;
        width: 2.1rem;
    }

    .success-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
    }

    .success-secondary-link {
        color: #365166;
        font-weight: 600;
        text-decoration: none;
    }

    .success-secondary-link:hover {
        color: #163247;
    }

    .success-visual {
        background:
            linear-gradient(160deg, rgba(19, 62, 81, 0.94), rgba(43, 97, 115, 0.84)),
            url('/images/s-home-back.jpg') center/cover;
        color: white;
        min-height: 100%;
        padding: 2.5rem 2rem;
        position: relative;
    }

    .success-visual::before {
        background: radial-gradient(circle at top, rgba(255, 255, 255, 0.18), transparent 38%);
        content: '';
        inset: 0;
        position: absolute;
    }

    .success-visual-content {
        display: grid;
        gap: 1.5rem;
        height: 100%;
        position: relative;
        z-index: 1;
    }

    .success-icon {
        align-items: center;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.25rem;
        display: inline-flex;
        font-size: 2rem;
        height: 4.5rem;
        justify-content: center;
        width: 4.5rem;
    }

    .success-visual h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.9rem;
        margin: 0;
    }

    .success-visual p {
        color: rgba(255, 255, 255, 0.84);
        margin: 0;
    }

    .success-meta {
        backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 1.4rem;
        display: grid;
        gap: 1rem;
        margin-top: auto;
        padding: 1.2rem;
    }

    .success-meta-row {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .success-meta-label {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.88rem;
    }

    .success-meta-value {
        font-weight: 700;
    }

    @media (max-width: 991.98px) {
        .success-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .success-copy,
        .success-visual {
            padding: 2rem 1.35rem;
        }

        .success-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .success-actions .btn,
        .success-actions a {
            width: 100%;
        }
    }
</style>

<section class="success-page d-flex align-items-center">
    <div class="container">
        <div class="success-shell">
            <div class="success-card">
                <div class="success-grid">
                    <div class="success-copy">
                        <p class="success-eyebrow">Success State</p>
                        <h1 class="success-title">Everything went through cleanly.</h1>
                        <div class="success-message"><%- success %></div>

                        <div class="success-points">
                            <div class="success-point">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Your latest action has been saved successfully.</span>
                            </div>
                            <div class="success-point">
                                <i class="fa-solid fa-envelope-open-text"></i>
                                <span>Any related confirmation details should already be on their way.</span>
                            </div>
                            <div class="success-point">
                                <i class="fa-solid fa-hand-pointer"></i>
                                <span>Use the actions below whenever you’re ready to continue.</span>
                            </div>
                        </div>

                        <div class="success-actions">
                            <a href="/" class="btn btn-primary">Go To Home</a>
                            <% if (user && user.role !== 'admin') { %>
                                <a href="<%= dashboardLink %>" class="btn btn-outline-secondary">Open Dashboard</a>
                            <% } %>
                            <a href="/" class="success-secondary-link">Continue browsing StayVista</a>
                        </div>
                    </div>

                    <div class="success-visual">
                        <div class="success-visual-content">
                            <div class="success-icon">
                                <i class="fa-solid fa-check"></i>
                            </div>

                            <div>
                                <h2>Confirmed</h2>
                                <p>The flow is complete and the next step is already lined up for the user.</p>
                            </div>

                            <div class="success-meta">
                                <div class="success-meta-row">
                                    <span class="success-meta-label">Brand</span>
                                    <span class="success-meta-value">StayVista</span>
                                </div>
                                <div class="success-meta-row">
                                    <span class="success-meta-label">Status</span>
                                    <span class="success-meta-value">Completed</span>
                                </div>
                                <div class="success-meta-row">
                                    <span class="success-meta-label">Redirect</span>
                                    <span class="success-meta-value">Manual</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
