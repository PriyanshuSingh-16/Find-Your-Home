<!-- RESET PASSWORD PAGE -->
<% layout('layout/boilerplate.ejs') -%>

<style>
    .auth-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        min-height: calc(100vh - 120px);
        padding: 1rem 0 4rem;
    }

    .auth-shell {
        align-items: stretch;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    }

    .auth-showcase,
    .auth-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.9rem;
        box-shadow: 0 1.4rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .auth-showcase {
        background:
            linear-gradient(150deg, rgba(255, 255, 255, 0.94) 0%, rgba(224, 239, 246, 0.9) 100%);
        padding: 2.4rem;
        position: relative;
    }

    .auth-showcase::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.45) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 18rem;
        position: absolute;
        right: -4rem;
        top: -4rem;
        width: 18rem;
    }

    .auth-showcase-content {
        position: relative;
        z-index: 1;
    }

    .auth-eyebrow {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.9rem;
        text-transform: uppercase;
    }

    .auth-showcase h1 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        font-style: italic;
        line-height: 1.12;
        margin-bottom: 1rem;
    }

    .auth-showcase p {
        color: #5e7687;
        line-height: 1.85;
        margin-bottom: 1rem;
    }

    .auth-points {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.4rem;
    }

    .auth-point {
        align-items: flex-start;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.1rem;
        display: flex;
        gap: 0.75rem;
        padding: 0.95rem 1rem;
    }

    .auth-point i {
        color: #2d7396;
        margin-top: 0.2rem;
    }

    .auth-point span {
        color: #4f6778;
        line-height: 1.7;
    }

    .auth-card {
        padding: 2rem;
    }

    .auth-card h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        margin-bottom: 0.35rem;
    }

    .auth-card-subtitle {
        color: #5e7687;
        margin-bottom: 1.4rem;
    }

    .auth-alert {
        background: #fbe7e9;
        border: 1px solid #f3c6cc;
        border-radius: 1rem;
        color: #a12f3f;
        margin-bottom: 1rem;
        padding: 0.9rem 1rem;
        text-align: center;
    }

    .auth-form {
        display: grid;
        gap: 1rem;
    }

    .auth-field {
        display: grid;
        gap: 0.45rem;
    }

    .auth-field label {
        color: #355166;
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }

    .auth-field .form-control {
        background: #fbfdfe;
        border: 1px solid #d9e6ee;
        border-radius: 1rem;
        flex: 1 1 auto;
        box-shadow: none;
        min-height: 3.35rem;
        padding: 0.8rem 1rem;
        width: 1%;
    }

    .auth-field .input-group {
        align-items: stretch;
        flex-wrap: nowrap;
    }

    .auth-field .input-group-prepend,
    .auth-field .input-group-append {
        display: flex;
    }

    .auth-field .input-group-text {
        align-items: center;
        background: #eef5f8;
        border: 1px solid #d9e6ee;
        color: #35617c;
        display: flex;
        justify-content: center;
        min-width: 5.2rem;
    }

    .auth-field .input-group-text:first-child {
        border-radius: 1rem 0 0 1rem;
    }

    .auth-field .input-group-text:last-child {
        border-left: 0;
        border-radius: 0 1rem 1rem 0;
        cursor: pointer;
    }

    .auth-field .input-group .form-control {
        border-left: 0;
        border-radius: 0;
        min-width: 0;
    }

    .auth-help {
        color: #6b8191;
        font-size: 0.85rem;
        line-height: 1.65;
        margin: 0;
    }

    .auth-actions {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.35rem;
    }

    .auth-actions .btn {
        border-radius: 999px;
        padding: 0.8rem 1.4rem;
    }

    .auth-links {
        display: grid;
        gap: 0.65rem;
        margin-top: 1rem;
    }

    .auth-links a {
        color: #2d7396;
        text-decoration: none;
    }

    .auth-links a:hover,
    .auth-links a:focus {
        text-decoration: underline;
    }

    @media (max-width: 991.98px) {
        .auth-shell {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .auth-showcase,
        .auth-card {
            padding: 1.35rem;
        }

        .auth-actions {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<section class="auth-page">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-showcase">
                <div class="auth-showcase-content">
                    <p class="auth-eyebrow">StayVista</p>
                    <h1>Set a stronger password and continue.</h1>
                    <p>Create a new password for your account and use it the next time you sign in. Once updated, the previous password will stop working immediately.</p>
                    <div class="auth-points">
                        <div class="auth-point">
                            <i class="fa-solid fa-lock"></i>
                            <span>Use a password that is hard to guess and different from the one you used before.</span>
                        </div>
                        <div class="auth-point">
                            <i class="fa-solid fa-user-shield"></i>
                            <span>This reset is tied to your secure link, so finish it only on a trusted device.</span>
                        </div>
                        <div class="auth-point">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            <span>After saving the new password, you can return to login and access your account normally.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <h2>Welcome, <%= name %></h2>
                <p class="auth-card-subtitle">Enter your new password below to complete the reset process.</p>

                <div class="auth-alert" id="invalid" hidden></div>

                <form novalidate id="form" action="/auth/change-password" class="auth-form validation-required" method="post">
                    <div class="auth-field">
                        <label for="pass">New Password</label>
                        <div class="input-group">
                            <input name="pass" type="password" class="form-control" id="pass" aria-describedby="passHelp" required pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[@#!%~]).{8,12}$" placeholder="Enter new password">
                            <div class="input-group-append">
                                <div class="input-group-text" onclick="toggleVisibility('pass')">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </div>
                        </div>
                        <p id="passHelp" class="auth-help">Use 8 to 12 characters with one uppercase letter, one number, and one special character.</p>
                    </div>

                    <div class="auth-field">
                        <label for="confirm-pass">Confirm New Password</label>
                        <div class="input-group">
                            <input name="confirm-pass" type="password" class="form-control" id="confirm-pass" required placeholder="Confirm new password">
                            <div class="input-group-append">
                                <div class="input-group-text" onclick="toggleVisibility('confirm-pass')">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="text" name="key" value="<%= key %>" hidden>

                    <div class="auth-actions">
                        <button type="submit" class="btn btn-primary">Change Password</button>
                        <a href="/auth/login">Back to Login</a>
                    </div>

                    <div class="auth-links">
                        <a href="/auth/forget-password">Need a different reset link? Request one again.</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function toggleVisibility(inputId) {
        const input = document.getElementById(inputId);
        input.type = input.type === 'password' ? 'text' : 'password';
    }

    const invalid = document.getElementById('invalid');
    const form = document.getElementById('form');

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        invalid.setAttribute('hidden', 'true');

        const pass = document.getElementById('pass').value;
        const confirmPass = document.getElementById('confirm-pass').value;

        if (form.checkValidity() && pass.trim().length > 0 && pass === confirmPass) {
            form.submit();
            return;
        }

        if (pass.trim().length === 0) {
            invalid.removeAttribute('hidden');
            invalid.innerText = 'Password length must be greater than 0 without spaces.';
            return;
        }

        if (pass !== confirmPass) {
            invalid.removeAttribute('hidden');
            invalid.innerText = 'Password and confirm password do not match.';
        }
    });
</script>
