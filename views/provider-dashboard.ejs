<!-- PROVIDER DASHBOARD (MATCHES RIDER DESIGN) -->
<% layout('layout/boilerplate.ejs') -%>

<%
    const profilePic = userInfo.profilePic || '/images/man.svg';
    const cancelledBookingsCount = userInfo.bookingCompleted.filter((booking) => booking.cancelledAt).length;
%>

<section class="rider-dashboard-page">
    <div class="container">
        <div class="dashboard-shell">

            <!-- HERO -->
            <div class="dashboard-card dashboard-hero">
                <div class="dashboard-hero-content">
                    <p class="dashboard-eyebrow">Provider Dashboard</p>
                    <h1>Welcome back, <%= userInfo.name %>.</h1>
                    <p>Manage your properties, bookings, and business insights from one place.</p>
                </div>
            </div>

            <!-- PROFILE -->
            <div class="dashboard-card">
                <div class="dashboard-profile">

                    <div class="dashboard-profile-card">
                        <img src="<%= profilePic %>" class="dashboard-avatar">
                        <h2><%= userInfo.name %></h2>
                        <p>Property Provider</p>

                        <a class="btn btn-primary" href="/provider/<%= userRoleID %>/edit">
                            Edit Profile
                        </a>

                        <a class="btn btn-outline-success" href="/messages">
                            Open Inbox
                        </a>

                        <a class="btn btn-outline-secondary" href="/property/new">
                            Add Property
                        </a>
                    </div>

                    <div class="dashboard-details">
                        <div class="dashboard-details-grid">

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Email</span>
                                <p class="dashboard-detail-value"><%= userInfo.email %></p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Phone</span>
                                <p class="dashboard-detail-value">+91 <%= userInfo.phone %></p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">GST</span>
                                <p class="dashboard-detail-value"><%= userInfo.gst || 'Not added' %></p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">License Certificate</span>
                                <p class="dashboard-detail-value">
                                    <% if (userInfo.licenseValidity) { %>
                                        <a href="<%= userInfo.licenseValidity %>" target="_blank" rel="noopener noreferrer">View certificate</a>
                                    <% } else { %>
                                        Not added
                                    <% } %>
                                </p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">License Valid Upto</span>
                                <p class="dashboard-detail-value">
                                    <%= userInfo.licenseValidUpto ? new Date(userInfo.licenseValidUpto).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Not added' %>
                                </p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Location</span>
                                <p class="dashboard-detail-value">
                                    <%= userInfo.address.city %>, <%= userInfo.address.state %>
                                </p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Total Properties</span>
                                <p class="dashboard-detail-value"><%= userInfo.properties.length %></p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Bookings</span>
                                <p class="dashboard-detail-value"><%= userInfo.bookingCompleted.length %></p>
                            </div>

                            <div class="dashboard-detail">
                                <span class="dashboard-detail-label">Cancelled Bookings</span>
                                <p class="dashboard-detail-value"><%= cancelledBookingsCount %></p>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- TABS -->
            <div class="dashboard-card dashboard-tabs">

                <ul class="nav nav-pills">
                    <li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#properties">Properties</button></li>
                    <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#completed">Bookings</button></li>
                </ul>

                <div class="tab-content">

                    <!-- PROPERTIES -->
                    <div class="tab-pane fade show active dashboard-tab-pane" id="properties">
                        <% if (userInfo.properties.length === 0) { %>
                            <div class="dashboard-empty">No properties added yet.</div>
                        <% } else { %>

                        <div class="dashboard-list">
                            <% for (let prop of userInfo.properties) { %>

                            <div class="dashboard-item">
                                <div class="dashboard-item-top">
                                    <span class="dashboard-item-badge">ID: <%= prop._id %></span>
                                </div>

                                <div class="dashboard-item-body">
                                    <img src="<%= (prop.images && prop.images[0]) || '/images/stayvista-logo.png' %>" class="dashboard-item-image">

                                    <div class="dashboard-item-content">
                                        <h3><%= prop.name %></h3>

                                        <div class="dashboard-inline-meta">
                                            <span>₹ <%= prop.rate %></span>
                                            <span class="text-capitalize"><%= prop.type %></span>
                                        </div>

                                        <div class="dashboard-item-actions">
                                            <a href="/property/<%= prop._id %>" class="btn btn-primary">View</a>
                                            <a href="/property/<%= prop._id %>/edit" class="btn btn-secondary">Edit</a>
                                            <button onclick="deleteProperty('<%= prop._id %>')" class="btn btn-danger">Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <% } %>
                        </div>

                        <% } %>
                    </div>

                    <!-- BOOKINGS -->
                    <div class="tab-pane fade dashboard-tab-pane" id="completed">
                        <% if (userInfo.bookingCompleted.length === 0) { %>
                            <div class="dashboard-empty">No confirmed bookings yet.</div>
                        <% } else { %>

                        <div class="dashboard-list">
                            <% for (let com of userInfo.bookingCompleted) { %>

                            <div class="dashboard-item">
                                <div class="dashboard-item-top">
                                    <span class="dashboard-item-badge">Booking: <%= com.id %></span>
                                    <span class="dashboard-status <%= com.cancelledAt ? 'status-declined' : com.checkedOutAt ? 'status-pending' : 'status-accepted' %>">
                                        <%= com.cancelledAt ? 'Cancelled' : com.checkedOutAt ? 'Checked Out' : 'Confirmed' %>
                                    </span>
                                </div>

                                <div class="dashboard-item-body">
                                    <img src="<%= com.property.images[0] %>" class="dashboard-item-image">

                                    <div class="dashboard-item-content">
                                        <h3><%= com.property.name %></h3>

                                        <div class="dashboard-inline-meta">
                                            <span>User: <%= com.by.name %></span>
                                            <span>₹ <%= com.property.bookingMoney %></span>
                                            <% if (com.paymentID) { %>
                                                <span>Payment Ref: <%= com.paymentID %></span>
                                            <% } %>
                                            <% if (com.checkInDate) { %>
                                                <span>Move-in: <%= com.checkInDate.toLocaleDateString('en-IN') %></span>
                                            <% } %>
                                            <% if (com.roomsBooked) { %>
                                                <span><%= com.roomsBooked %> room(s)</span>
                                            <% } %>
                                            <% if (com.checkedOutAt) { %>
                                                <span>Checked out: <%= com.checkedOutAt.toLocaleDateString('en-IN') %></span>
                                            <% } %>
                                            <% if (com.cancelledAt) { %>
                                                <span>Cancelled on: <%= com.cancelledAt.toLocaleDateString('en-IN') %></span>
                                            <% } %>
                                        </div>

                                        <div class="dashboard-comment">
                                            <% if (com.cancelledAt) { %>
                                                <strong>Cancellation Reason:</strong> <%= com.cancellationReason || 'No reason shared.' %>
                                            <% } else { %>
                                                <strong>Comment:</strong> <%= com.comment || 'No comment' %>
                                            <% } %>
                                        </div>

                                        <div class="dashboard-item-actions" style="margin-top: 0.8rem;">
                                            <a href="/messages?rider=<%= com.by._id %>" class="btn btn-outline-primary" title="Send a message to the rider">
                                                <i class="fa fa-envelope-o"></i> Contact Rider
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <% } %>
                        </div>

                        <% } %>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
