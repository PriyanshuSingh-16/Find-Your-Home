<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>PG Finder V2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/starability-growRotate.min.css">
    <link rel="stylesheet" href="/css/photoswipe.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/site-data/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/site-data/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/site-data/favicon-16x16.png">
    <link rel="manifest" href="/site-data/site.webmanifest">
    <link rel="mask-icon" href="/site-data/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" contsent="#ffffff">
    <style>
        body {
            background: #f5fafc;
            color: #18374d;
        }

        .site-header {
            padding: 1rem 0 0;
        }

        .site-navbar {
            background: rgba(255, 255, 255, 0.82) !important;
            border: 1px solid rgba(13, 110, 253, 0.08);
            border-radius: 1.5rem;
            box-shadow: 0 1rem 2.5rem rgba(31, 56, 88, 0.08);
            padding: 0.85rem 1.1rem;
        }

        .site-navbar .navbar-brand {
            align-items: center;
            display: inline-flex;
            gap: 0.75rem;
        }

        .site-navbar .navbar-brand img {
            filter: drop-shadow(0 0.45rem 0.85rem rgba(42, 103, 137, 0.12));
        }

        .site-navbar .navbar-toggler {
            border: 1px solid rgba(13, 110, 253, 0.16);
            border-radius: 1rem;
            padding: 0.5rem 0.7rem;
        }

        .top-nav-links {
            gap: 0.5rem;
        }

        .top-nav-links .nav-link {
            background: rgba(255, 255, 255, 0.65);
            border: 1px solid rgba(13, 110, 253, 0.16);
            border-radius: 999px;
            color: #18374d !important;
            margin: 0.25rem 0;
            padding: 0.45rem 0.9rem;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .top-nav-links .nav-link:hover,
        .top-nav-links .nav-link:focus {
            background-color: #2d7396;
            border-color: #2d7396;
            box-shadow: 0 0.75rem 1.2rem rgba(45, 115, 150, 0.16);
            color: #fff !important;
        }

        .top-auth-link {
            background: rgba(255, 255, 255, 0.65);
            border: 1px solid rgba(13, 110, 253, 0.16);
            border-radius: 999px;
            color: #18374d !important;
            margin: 0.25rem 0;
            padding: 0.45rem 0.9rem;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .top-auth-link:hover,
        .top-auth-link:focus {
            background-color: #2d7396;
            border-color: #2d7396;
            box-shadow: 0 0.75rem 1.2rem rgba(45, 115, 150, 0.16);
            color: #fff !important;
            text-decoration: none;
        }

        .site-profile-link img {
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 0.8rem 1.4rem rgba(31, 56, 88, 0.12);
        }

        .site-footer {
            padding-bottom: 1.25rem;
        }

        .site-footer-shell {
            background: linear-gradient(180deg, rgba(232, 243, 248, 0.95) 0%, rgba(214, 232, 241, 0.95) 100%);
            border: 1px solid rgba(13, 110, 253, 0.08);
            border-radius: 2rem;
            box-shadow: 0 1.3rem 2.8rem rgba(31, 56, 88, 0.08);
            overflow: hidden;
        }

        .site-footer-main {
            padding: 2.5rem 0 1.5rem;
        }

        .site-footer-links a {
            color: #163247;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .site-footer-links a:hover,
        .site-footer-links a:focus {
            color: #2d7396;
        }

        .site-footer-bottom {
            background: rgba(255, 255, 255, 0.42);
            border-top: 1px solid rgba(13, 110, 253, 0.08);
            color: #365166;
        }
    </style>
</head>
<body style="scroll-behavior: smooth">
    <section id="flash-holder" class="position-fixed col-10 col-md-3 text-white" style="top: 10%; right: 5%; z-index: 9999"></section>
    <script src="/js/include-first.js"></script>

    <header class="site-header mb-2">
        <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light site-navbar" data-aos="fade-down">
            <div class="container-fluid px-0">
                <a class="navbar-brand" href="/">
                    <img src="/images/party.png" alt="pg-finder-logo" width="60px">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse mb-2" id="navbarNav">
                    <ul class="navbar-nav top-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" href="/property/search">Homes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#about">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#why-us">Why Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#team">Team</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#help">Contact Us</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <% if (user) { %>
                            <% if (user.role !== 'admin') { %>
                                <li class="nav-item me-lg-2 mb-2 mb-lg-0">
                                    <a href="<%= `/${user.role}/dashboard` %>" class="nav-link p-0 site-profile-link">
                                        <img
                                                src="<%= userDet.profilePic || '/images/man.svg' %>"
                                                class="rounded-circle"
                                                height="60"
                                                style="aspect-ratio: 1; object-fit: cover"
                                                alt="user-icon"
                                                loading="lazy"
                                        />
                                    </a>
                                </li>
                            <% } %>
                            <li class="nav-item">
                                <a role="button" href="/auth/logout" class="btn text-black top-auth-link">Logout</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a role="button" href="/auth/login" class="btn text-black top-auth-link">Login</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
        </div>
    </header>

    <section id="main-body" style="min-height: 100vh;">
        <%- body -%>
    </section>

    <footer data-aos="fade-up" class="site-footer" style="min-width: -webkit-fill-available;">
        <div class="container">
            <footer class="text-center text-dark site-footer-shell">
                <div class="container">
                    <section class="site-footer-main">
                        <div class="row text-center d-flex justify-content-center pt-5">
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/property/search" class="text-black">Homes</a>
                                </h6>
                            </div>
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/#about" class="text-black">About us</a>
                                </h6>
                            </div>
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/#why-us" class="text-black">Why us!</a>
                                </h6>
                            </div>
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/#features" class="text-black">Features</a>
                                </h6>
                            </div>
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/#team" class="text-black">Team</a>
                                </h6>
                            </div>
                            <div class="col-md-2 site-footer-links">
                                <h6 class="text-uppercase font-weight-bold">
                                    <a href="/#help" class="text-black">Contact Us</a>
                                </h6>
                            </div>
                        </div>
                    </section>

                    <hr class="my-3" />

                    <section class="mb-2">
                        <div class="row d-flex justify-content-center">
                            <div class="col-lg-8">
                                <p>
                                    PG Finder is a platform that helps users find the perfect PG or hostel for their stay across different cities and states in India.
                                </p>
                            </div>
                        </div>
                    </section>
                    <section class="text-center mb-5">
                        <a href="#" class="text-black me-4 fs-1">
                            <i class="fab fa-github"></i>
                        </a>
                    </section>
                </div>
                <div
                        class="site-footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start p-3 row-gap-2">
                    <div>© 2026 Copyright: All rights reserved

                    </div>
                    <div>
                        Developed by Shreyas Patil
                        <br>
                        Gachibowli, Hyderabad
                    </div>
                    <div class="text-md-end">
                        Contact: +91 7378472876
                        <br>
                        Email: shreyaspatil9131@gmail.com
                    </div>
                </div>
            </footer>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/5a010fa73c.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,400;0,600;1,100;1,400;1,600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="/js/include.js"></script>

    <script>
        AOS.init();
    </script>
</body>
</html>
