<!-- PG EDIT FORM -->
<% layout('layout/boilerplate.ejs') -%>
<%
    const address = property.address || {};
    const selectedAmenities = new Set((property.amenities || []).map((item) => item.name));
    const allowedRules = new Set((property.rules || []).filter((item) => item.allowed).map((item) => item.name));
    const foodMap = {};
    for (const item of (property.food || []))
        foodMap[item.name] = item.detail || '';
    const otherChargesMap = {};
    for (const item of (property.otherCharges || []))
        otherChargesMap[item.name] = item.detail || '';
%>

<style>
    .pg-form-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        padding: 1rem 0 4rem;
    }

    .pg-form-shell {
        display: grid;
        gap: 1.5rem;
    }

    .pg-form-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.8rem;
        box-shadow: 0 1.3rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .pg-form-hero {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(228, 241, 247, 0.96) 100%);
        padding: 2.25rem;
        position: relative;
    }

    .pg-form-hero::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.42) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 18rem;
        position: absolute;
        right: -5rem;
        top: -5rem;
        width: 18rem;
    }

    .pg-form-hero-grid {
        align-items: end;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.8fr) minmax(260px, 0.9fr);
        position: relative;
        z-index: 1;
    }

    .pg-form-eyebrow {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
    }

    .pg-form-hero h1 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 3.6vw, 3rem);
        font-style: italic;
        margin-bottom: 0.65rem;
    }

    .pg-form-hero p {
        color: #597183;
        margin: 0;
        max-width: 44rem;
    }

    .pg-hero-stat {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(76, 134, 168, 0.16);
        border-radius: 1.6rem;
        display: grid;
        gap: 1rem;
        padding: 1.35rem;
    }

    .pg-hero-stat h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.35rem;
        margin: 0;
    }

    .pg-hero-stat p {
        color: #5e7687;
        font-size: 0.95rem;
        margin: 0;
    }

    .pg-form-body {
        padding: 2rem;
    }

    .pg-form-section + .pg-form-section {
        margin-top: 2rem;
    }

    .pg-form-section h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.45rem;
        margin-bottom: 0.35rem;
    }

    .pg-form-section p {
        color: #5e7687;
        margin-bottom: 1.2rem;
    }

    .pg-form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pg-form-grid.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pg-field {
        display: grid;
        gap: 0.45rem;
    }

    .pg-field.full {
        grid-column: 1 / -1;
    }

    .pg-field label,
    .pg-chip-group > span {
        color: #355166;
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0;
    }

    .pg-field .form-control,
    .pg-field .form-select {
        background: #fbfdfe;
        border: 1px solid #d9e6ee;
        border-radius: 1rem;
        box-shadow: none;
        min-height: 3.35rem;
        padding: 0.8rem 1rem;
    }

    .pg-field textarea.form-control {
        min-height: 8rem;
    }

    .pg-field .input-group-text {
        background: #eef5f8;
        border: 1px solid #d9e6ee;
        border-radius: 1rem 0 0 1rem;
        color: #35617c;
        min-width: 3.4rem;
        justify-content: center;
    }

    .pg-field .input-group .form-control {
        border-left: 0;
        border-radius: 0 1rem 1rem 0;
    }

    .pg-field-help {
        color: #6b8393;
        font-size: 0.85rem;
        margin: 0;
    }

    .pg-chip-group {
        display: grid;
        gap: 0.8rem;
    }

    .pg-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .pg-chip {
        align-items: center;
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.14);
        border-radius: 999px;
        display: inline-flex;
        gap: 0.5rem;
        min-width: 138px;
        padding: 0.7rem 1rem;
    }

    .pg-chip .form-check-input {
        margin: 0;
        position: static;
    }

    .pg-chip label {
        color: #4f6778;
        font-weight: 500;
        margin: 0;
    }

    .pg-detail-list {
        display: grid;
        gap: 0.8rem;
    }

    .pg-detail-row {
        align-items: center;
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.14);
        border-radius: 1.2rem;
        display: grid;
        gap: 0.75rem;
        grid-template-columns: auto 1fr minmax(180px, 260px);
        padding: 0.85rem 1rem;
    }

    .pg-detail-row .form-check-input {
        margin: 0;
    }

    .pg-detail-row label {
        color: #4f6778;
        font-weight: 500;
        margin: 0;
    }

    .pg-detail-row .form-control {
        min-height: 2.9rem;
    }

    .pg-gallery-upload {
        border: 1px dashed rgba(76, 134, 168, 0.24);
        border-radius: 1.4rem;
        padding: 1rem;
    }

    .pg-submit {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.75rem;
    }

    .pg-submit .btn {
        border-radius: 999px;
        padding: 0.8rem 1.5rem;
    }

    @media (max-width: 991.98px) {
        .pg-form-hero-grid,
        .pg-form-grid,
        .pg-form-grid.three,
        .pg-detail-row {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .pg-form-hero,
        .pg-form-body {
            padding: 1.35rem;
        }
    }
</style>

<section class="pg-form-page">
    <div class="container">
        <div class="pg-form-shell">
            <div class="pg-form-card pg-form-hero">
                <div class="pg-form-hero-grid">
                    <div>
                        <p class="pg-form-eyebrow">Property Details</p>
                        <h1>Edit your PG listing.</h1>
                        <p>Update every part of the listing: property details, exact location, rules, amenities, pricing, and images so the page stays accurate and conversion-ready.</p>
                    </div>

                    <div class="pg-hero-stat">
                        <h2>Editing Checklist</h2>
                        <p>Refresh address, revise pricing, replace images if needed, and keep your Google Maps pin link accurate for better discovery and trust.</p>
                    </div>
                </div>
            </div>

            <div class="pg-form-card pg-form-body">
                <form
                    id="form"
                    enctype="multipart/form-data"
                    class="validation-required"
                    novalidate
                    data-selected-state="<%= address.state || '' %>"
                    data-selected-city="<%= address.city || '' %>"
                >
                    <div class="pg-form-section">
                        <h2>Basic Information</h2>
                        <p>Update the core details riders notice first in search and on the property page.</p>
                        <div class="pg-form-grid">
                            <div class="pg-field">
                                <label for="name">PG Name</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-home"></i>
                                        </div>
                                    </div>
                                    <input id="name" name="name" placeholder="Enter PG name" type="text" class="form-control" value="<%= property.name %>" required>
                                </div>
                                <p class="pg-field-help">Keep the name short and memorable so users can find it easily.</p>
                            </div>

                            <div class="pg-field">
                                <label for="tagLine">Tag Line</label>
                                <input id="tagLine" name="tagLine" placeholder="Safe stay near campus with meals included" type="text" class="form-control" value="<%= property.tagline || '' %>" required>
                                <p class="pg-field-help">A short one-line summary that appears under the property name.</p>
                            </div>

                            <div class="pg-field">
                                <label for="maxOccupancy">Max Occupancy</label>
                                <input id="maxOccupancy" name="maxOccupancy" placeholder="Enter max occupancy" type="number" min="1" max="1000" class="form-control" value="<%= property.maxOcc %>" required>
                            </div>

                            <div class="pg-field">
                                <label for="availableRooms">Available Rooms</label>
                                <input id="availableRooms" name="availableRooms" placeholder="Enter number of rooms available for booking" type="number" min="1" max="1000" class="form-control" value="<%= property.availableRooms || property.maxOcc || '' %>" required>
                                <p class="pg-field-help">This controls how many rooms can be booked for overlapping dates.</p>
                            </div>

                            <div class="pg-field">
                                <label for="since">Operating Since</label>
                                <input id="since" name="since" placeholder="Enter starting year" type="number" min="1947" max="<%= new Date().getFullYear() %>" class="form-control" value="<%= property.since %>" required>
                            </div>

                            <div class="pg-field full">
                                <label for="desc">Description</label>
                                <textarea id="desc" name="desc" rows="5" class="form-control" placeholder="Describe rooms, surroundings, commute, meals, cleanliness, security, and what makes the property a good fit." required><%= property.desc %></textarea>
                                <p class="pg-field-help">Write at least 50 characters so the listing feels informative and credible.</p>
                            </div>

                            <div class="pg-field full">
                                <div class="pg-chip-group">
                                    <span>Property Type</span>
                                    <div class="pg-chip-list">
                                        <div class="pg-chip">
                                            <input name="type" id="type_0" type="radio" class="form-check-input" value="male" <%= property.type === 'male' ? 'checked' : '' %> required>
                                            <label for="type_0">Male</label>
                                        </div>
                                        <div class="pg-chip">
                                            <input name="type" id="type_1" type="radio" class="form-check-input" value="female" <%= property.type === 'female' ? 'checked' : '' %> required>
                                            <label for="type_1">Female</label>
                                        </div>
                                        <div class="pg-chip">
                                            <input name="type" id="type_2" type="radio" class="form-check-input" value="co" <%= property.type === 'co' ? 'checked' : '' %> required>
                                            <label for="type_2">Co-Living</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="pg-field full">
                                <div class="pg-chip-group">
                                    <span>Bed Types</span>
                                    <div class="pg-chip-list">
                                        <div class="pg-chip">
                                            <input name="occupancy" id="beds_0" type="checkbox" class="form-check-input" value="single" <%= property.occupancy.includes('single') ? 'checked' : '' %>>
                                            <label for="beds_0">Single</label>
                                        </div>
                                        <div class="pg-chip">
                                            <input name="occupancy" id="beds_1" type="checkbox" class="form-check-input" value="double" <%= property.occupancy.includes('double') ? 'checked' : '' %>>
                                            <label for="beds_1">Double</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pg-form-section">
                        <h2>Address Details</h2>
                        <p>Update the full address and exact pin so riders land at the right location without confusion.</p>
                        <div class="pg-form-grid three">
                            <div class="pg-field full">
                                <label for="addBuilding">Building Address</label>
                                <input id="addBuilding" name="addBuilding" placeholder="Building / hostel / house name" type="text" class="form-control" value="<%= address.building || '' %>" required>
                            </div>

                            <div class="pg-field">
                                <label for="addL1">Address Line 1</label>
                                <input id="addL1" name="addL1" placeholder="Street / area / locality" type="text" class="form-control" value="<%= address.addL1 || '' %>" required>
                            </div>

                            <div class="pg-field">
                                <label for="addL2">Address Line 2</label>
                                <input id="addL2" name="addL2" placeholder="Optional additional line" type="text" class="form-control" value="<%= address.addL2 || '' %>">
                            </div>

                            <div class="pg-field">
                                <label for="landmark">Landmark</label>
                                <input id="landmark" name="landmark" placeholder="Nearest known landmark" type="text" class="form-control" value="<%= address.landmark || '' %>" required>
                            </div>

                            <div class="pg-field">
                                <label for="state">State</label>
                                <select id="state" name="state" class="form-select" required>
                                    <option value="">Select state</option>
                                </select>
                            </div>

                            <div class="pg-field">
                                <label for="city">City</label>
                                <select id="city" name="city" class="form-select" required disabled>
                                    <option value="">Select city</option>
                                </select>
                            </div>

                            <div class="pg-field">
                                <label for="zipCode">Zip Code</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-location-arrow"></i>
                                        </div>
                                    </div>
                                    <input id="zipCode" name="zipCode" placeholder="6-digit zip code" type="text" pattern="\d{6}" class="form-control" value="<%= address.zipcode || '' %>" required>
                                </div>
                            </div>

                            <div class="pg-field full">
                                <label for="exactLocationLink">Exact Google Maps Pin Link</label>
                                <input id="exactLocationLink" name="exactLocationLink" placeholder="Paste the Google Maps location URL of the exact pin" type="url" class="form-control" value="<%= property.exactLocationLink || '' %>" required>
                                <p class="pg-field-help">Open Google Maps, drop the exact pin, tap Share, and paste the link here.</p>
                            </div>
                        </div>
                    </div>

                    <div class="pg-form-section">
                        <h2>Rules, Amenities, and Other Details</h2>
                        <p>Update the practical things riders actually compare: food, amenities, house rules, and extra conditions.</p>

                        <div class="pg-form-grid">
                            <div class="pg-field full">
                                <label>Food Related Rules</label>
                                <div class="pg-detail-list">
                                    <div class="pg-detail-row has-text-input">
                                        <input name="food" id="food_0" type="checkbox" class="form-check-input" value="food-available" <%= foodMap['food-available'] !== undefined ? 'checked' : '' %>>
                                        <label for="food_0">Food Available</label>
                                        <input name="foodText" type="text" class="form-control" placeholder="Breakfast and dinner available" value="<%= foodMap['food-available'] || '' %>">
                                    </div>
                                    <div class="pg-detail-row has-text-input">
                                        <input name="food" id="food_1" type="checkbox" class="form-check-input" value="meals-provided" <%= foodMap['meals-provided'] !== undefined ? 'checked' : '' %>>
                                        <label for="food_1">Meal Type</label>
                                        <input name="foodText" type="text" class="form-control" placeholder="Veg / Non-Veg" value="<%= foodMap['meals-provided'] || '' %>">
                                    </div>
                                    <div class="pg-detail-row has-text-input">
                                        <input name="food" id="food_2" type="checkbox" class="form-check-input" value="fridge" <%= foodMap['fridge'] !== undefined ? 'checked' : '' %>>
                                        <label for="food_2">Fridge</label>
                                        <input name="foodText" type="text" class="form-control" placeholder="Shared fridge on each floor" value="<%= foodMap['fridge'] || '' %>">
                                    </div>
                                    <div class="pg-detail-row has-text-input">
                                        <input name="food" id="food_3" type="checkbox" class="form-check-input" value="food-charges" <%= foodMap['food-charges'] !== undefined ? 'checked' : '' %>>
                                        <label for="food_3">Food Charges</label>
                                        <input name="foodText" type="text" class="form-control" placeholder="Included / extra charges" value="<%= foodMap['food-charges'] || '' %>">
                                    </div>
                                </div>
                            </div>

                            <div class="pg-field full">
                                <div class="pg-chip-group">
                                    <span>Amenities Provided</span>
                                    <div class="pg-chip-list">
                                        <div class="pg-chip"><input name="amenities" id="amenities_0" type="checkbox" class="form-check-input" value="wifi" <%= selectedAmenities.has('wifi') ? 'checked' : '' %>><label for="amenities_0">WiFi</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_1" type="checkbox" class="form-check-input" value="power-backup" <%= selectedAmenities.has('power-backup') ? 'checked' : '' %>><label for="amenities_1">Power Backup</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_2" type="checkbox" class="form-check-input" value="room-cleaning" <%= selectedAmenities.has('room-cleaning') ? 'checked' : '' %>><label for="amenities_2">Room Cleaning</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_3" type="checkbox" class="form-check-input" value="tv" <%= selectedAmenities.has('tv') ? 'checked' : '' %>><label for="amenities_3">TV</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_4" type="checkbox" class="form-check-input" value="lift" <%= selectedAmenities.has('lift') ? 'checked' : '' %>><label for="amenities_4">Lift</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_5" type="checkbox" class="form-check-input" value="laundary" <%= selectedAmenities.has('laundary') ? 'checked' : '' %>><label for="amenities_5">Laundry</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_6" type="checkbox" class="form-check-input" value="fridge" <%= selectedAmenities.has('fridge') ? 'checked' : '' %>><label for="amenities_6">Fridge</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_7" type="checkbox" class="form-check-input" value="water-cooler" <%= selectedAmenities.has('water-cooler') ? 'checked' : '' %>><label for="amenities_7">Water Cooler</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_8" type="checkbox" class="form-check-input" value="warden" <%= selectedAmenities.has('warden') ? 'checked' : '' %>><label for="amenities_8">Warden</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_9" type="checkbox" class="form-check-input" value="microwave" <%= selectedAmenities.has('microwave') ? 'checked' : '' %>><label for="amenities_9">Microwave</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_10" type="checkbox" class="form-check-input" value="parking" <%= selectedAmenities.has('parking') ? 'checked' : '' %>><label for="amenities_10">Parking</label></div>
                                        <div class="pg-chip"><input name="amenities" id="amenities_11" type="checkbox" class="form-check-input" value="car-parking" <%= selectedAmenities.has('car-parking') ? 'checked' : '' %>><label for="amenities_11">4-Wheeler Parking</label></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pg-field full">
                                <div class="pg-chip-group">
                                    <span>House Rules</span>
                                    <div class="pg-chip-list">
                                        <div class="pg-chip"><input name="rules" id="rules_0" type="checkbox" class="form-check-input" value="visitor" <%= allowedRules.has('visitor') ? 'checked' : '' %>><label for="rules_0">Visitor Entry</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_1" type="checkbox" class="form-check-input" value="non-veg-food" <%= allowedRules.has('non-veg-food') ? 'checked' : '' %>><label for="rules_1">Non-Veg Food</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_2" type="checkbox" class="form-check-input" value="other-gender" <%= allowedRules.has('other-gender') ? 'checked' : '' %>><label for="rules_2">Other Gender</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_3" type="checkbox" class="form-check-input" value="smoking" <%= allowedRules.has('smoking') ? 'checked' : '' %>><label for="rules_3">Smoking</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_4" type="checkbox" class="form-check-input" value="drinking" <%= allowedRules.has('drinking') ? 'checked' : '' %>><label for="rules_4">Drinking</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_5" type="checkbox" class="form-check-input" value="loud-music" <%= allowedRules.has('loud-music') ? 'checked' : '' %>><label for="rules_5">Loud Music</label></div>
                                        <div class="pg-chip"><input name="rules" id="rules_6" type="checkbox" class="form-check-input" value="party" <%= allowedRules.has('party') ? 'checked' : '' %>><label for="rules_6">Party</label></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pg-field full">
                                <label>Other Charges and Details</label>
                                <div class="pg-detail-list">
                                    <div class="pg-detail-row has-text-input">
                                        <input name="otherCharges" id="otherCharges_0" type="checkbox" class="form-check-input" value="laundary" <%= otherChargesMap['laundary'] !== undefined ? 'checked' : '' %>>
                                        <label for="otherCharges_0">Laundry</label>
                                        <input name="otherChargesText" type="text" class="form-control" placeholder="Included / extra monthly" value="<%= otherChargesMap['laundary'] || '' %>">
                                    </div>
                                    <div class="pg-detail-row has-text-input">
                                        <input name="otherCharges" id="otherCharges_1" type="checkbox" class="form-check-input" value="notice-period" <%= otherChargesMap['notice-period'] !== undefined ? 'checked' : '' %>>
                                        <label for="otherCharges_1">Notice Period</label>
                                        <input name="otherChargesText" type="text" class="form-control" placeholder="30 days / 60 days" value="<%= otherChargesMap['notice-period'] || '' %>">
                                    </div>
                                    <div class="pg-detail-row has-text-input">
                                        <input name="otherCharges" id="otherCharges_2" type="checkbox" class="form-check-input" value="gate-time" <%= otherChargesMap['gate-time'] !== undefined ? 'checked' : '' %>>
                                        <label for="otherCharges_2">Gate Closing Time</label>
                                        <input name="otherChargesText" type="text" class="form-control" placeholder="10:30 PM / no closing time" value="<%= otherChargesMap['gate-time'] || '' %>">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pg-form-section">
                        <h2>Money Details</h2>
                        <p>Update the pricing clearly so the listing stays transparent.</p>
                        <div class="pg-form-grid">
                            <div class="pg-field">
                                <label for="rate">Rate Per Month</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="fa fa-rupee"></i></div>
                                    </div>
                                    <input id="rate" name="rate" placeholder="Enter monthly price" type="number" min="1" class="form-control" value="<%= property.rate %>" required>
                                </div>
                            </div>

                            <div class="pg-field">
                                <label for="bookingMoney">Booking Amount</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="fa fa-rupee"></i></div>
                                    </div>
                                    <input id="bookingMoney" name="bookingMoney" placeholder="Enter booking amount" type="number" min="1" max="10000" class="form-control" value="<%= property.bookingMoney %>" required>
                                </div>
                                <p class="pg-field-help">Maximum booking amount is 10,000 INR.</p>
                            </div>
                        </div>
                    </div>

                    <div class="pg-form-section">
                        <h2>Images & Videos</h2>
                        <p>Upload new images or videos only if you want to replace the existing gallery for this PG.</p>
                        <div class="pg-gallery-upload">
                            <div class="pg-field">
                                <label for="property-image">Property Images</label>
                                <input id="property-image" type="file" name="property-image" class="form-control" multiple accept="image/*">
                                <p class="pg-field-help">Leave empty to keep current images. All formats supported (JPEG, PNG, WebP, GIF, BMP, etc.). Max 20 images, 5MB each.</p>
                            </div>
                        </div>
                        <div class="pg-gallery-upload" style="margin-top: 1rem;">
                            <div class="pg-field">
                                <label for="property-videos">Property Videos</label>
                                <input id="property-videos" type="file" name="property-videos" class="form-control" multiple accept="video/*">
                                <p class="pg-field-help">Leave empty to keep current videos. All video formats supported (MP4, WebM, MOV, AVI, MKV, etc.). Max 5 videos, 50MB each.</p>
                            </div>
                        </div>
                    </div>

                    <div class="pg-submit">
                        <button name="submit" type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('form');
    const stateSelector = document.getElementById('state');
    const citySelector = document.getElementById('city');
    const selectedState = form.dataset.selectedState || '';
    const selectedCity = form.dataset.selectedCity || '';

    async function fetchStates() {
        return fetch('/state-list').then((response) => response.json());
    }

    async function fetchCities(state) {
        return fetch(`/city/${state}`).then((response) => response.json());
    }

    function populateCities(cities, activeCity) {
        citySelector.innerHTML = '<option value="">Select city</option>';

        for (const city of cities) {
            const option = document.createElement('option');
            option.value = city;
            option.innerText = city;
            if (city === activeCity)
                option.selected = true;
            citySelector.appendChild(option);
        }

        if (cities.length > 0)
            citySelector.removeAttribute('disabled');
        else
            citySelector.setAttribute('disabled', 'true');
    }

    fetchStates().then((states) => {
        for (const state of states) {
            const option = document.createElement('option');
            option.value = state;
            option.innerText = state;
            if (state === selectedState)
                option.selected = true;
            stateSelector.appendChild(option);
        }

        if (selectedState)
            return fetchCities(selectedState).then((cities) => populateCities(cities, selectedCity));
    });

    stateSelector.addEventListener('change', (e) => {
        const value = e.target.value;

        if (!value) {
            populateCities([], '');
            return;
        }

        fetchCities(value).then((cities) => populateCities(cities, ''));
    });

    for (const inputHolder of document.getElementsByClassName('has-text-input')) {
        const textInput = inputHolder.children[inputHolder.children.length - 1];
        const checkbox = inputHolder.children[0];

        if (!checkbox.checked)
            textInput.setAttribute('disabled', 'true');

        checkbox.addEventListener('change', (e) => {
            if (e.target.checked)
                textInput.removeAttribute('disabled');
            else
                textInput.setAttribute('disabled', 'true');
        });
    }

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        if (!form.checkValidity())
            return;

        // Validate file counts
        const imgInput = document.getElementById('property-image');
        const vidInput = document.getElementById('property-videos');

        if (imgInput.files.length > 20) {
            addFlash('error', 'Maximum 20 images allowed. You selected ' + imgInput.files.length);
            return;
        }

        if (vidInput && vidInput.files.length > 5) {
            addFlash('error', 'Maximum 5 videos allowed. You selected ' + vidInput.files.length);
            return;
        }

        const formData = new FormData();
        const fields = [
            'name',
            'addBuilding',
            'addL1',
            'addL2',
            'exactLocationLink',
            'landmark',
            'state',
            'city',
            'zipCode',
            'maxOccupancy',
            'availableRooms',
            'type',
            'desc',
            'tagLine',
            'since',
            'rate',
            'bookingMoney'
        ];

        for (const field of fields) {
            const input = form.elements[field];
            if (input)
                formData.append(field, input.value || '');
        }

        for (const checkbox of form.querySelectorAll('input[name="occupancy"]:checked'))
            formData.append('occupancy', checkbox.value);

        for (const checkbox of form.querySelectorAll('input[name="amenities"]:checked'))
            formData.append('amenities', checkbox.value);

        for (const checkbox of form.querySelectorAll('input[name="rules"]:checked'))
            formData.append('rules', checkbox.value);

        for (const row of form.querySelectorAll('.has-text-input')) {
            const checkbox = row.querySelector('input[type="checkbox"]');
            const textInput = row.querySelector('input[type="text"]');
            if (!checkbox || !textInput || !checkbox.checked) continue;

            if (checkbox.name === 'food') {
                formData.append('food', checkbox.value);
                formData.append('foodText', textInput.value || '');
            }

            if (checkbox.name === 'otherCharges') {
                formData.append('otherCharges', checkbox.value);
                formData.append('otherChargesText', textInput.value || '');
            }
        }

        const imageInput = document.getElementById('property-image');
        for (const file of imageInput.files)
            formData.append('property-image', file);

        const videoInput = document.getElementById('property-videos');
        if (videoInput) {
            for (const file of videoInput.files)
                formData.append('property-videos', file);
        }

        axios({
            url: '/property/<%= property.id %>?_method=patch',
            method: 'post',
            data: formData,
        })
            .then(() => {
                addFlash('success', 'Property has been successfully updated!');
                setTimeout(() => {
                    window.location = '/property/<%= property.id %>/';
                }, 2000);
            })
            .catch((error) => {
                const errors = error.response?.data?.errors;
                if (errors && errors.length > 0) {
                    for (const err of errors)
                        addFlash('error', err.msg);
                    return;
                }

                const message = error.response?.data?.error || error.message || 'Could not update the property.';
                addFlash('error', message);
            });
    });
</script>
