<!-- PROVIDER REGISTRATION FORM -->
<% layout('layout/boilerplate.ejs') -%>
<%
    const address = userInfo.address || {};
    const profilePic = userInfo.profilePic || '/images/man.svg';
    const hasDob = userInfo.dob instanceof Date && !Number.isNaN(userInfo.dob.getTime());
    const hasLicenseDate = userInfo.licenseValidUpto instanceof Date && !Number.isNaN(userInfo.licenseValidUpto.getTime());
%>

<style>
    .provider-form-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        padding: 1rem 0 4rem;
    }

    .provider-form-shell {
        display: grid;
        gap: 1.5rem;
    }

    .provider-form-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.8rem;
        box-shadow: 0 1.3rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .provider-form-hero {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(228, 241, 247, 0.96) 100%);
        padding: 2.25rem;
        position: relative;
    }

    .provider-form-hero::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.42) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 16rem;
        position: absolute;
        right: -4rem;
        top: -4rem;
        width: 16rem;
    }

    .provider-form-hero-grid {
        align-items: center;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
        position: relative;
        z-index: 1;
    }

    .provider-form-eyebrow {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
    }

    .provider-form-hero h1 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 3.6vw, 3rem);
        font-style: italic;
        margin-bottom: 0.65rem;
    }

    .provider-form-hero p {
        color: #597183;
        margin: 0;
        max-width: 40rem;
    }

    .provider-profile-card {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(76, 134, 168, 0.16);
        border-radius: 1.6rem;
        padding: 1.4rem;
        text-align: center;
    }

    .provider-avatar {
        aspect-ratio: 1;
        border: 4px solid rgba(255, 255, 255, 0.95);
        border-radius: 50%;
        box-shadow: 0 0.8rem 2rem rgba(31, 56, 88, 0.12);
        height: 132px;
        object-fit: cover;
        width: 132px;
    }

    .provider-profile-card h2 {
        color: #163247;
        font-size: 1.2rem;
        margin: 0.9rem 0 0.2rem;
    }

    .provider-profile-card p {
        color: #5e7687;
        margin: 0;
    }

    .provider-form-body {
        padding: 2rem;
    }

    .provider-form-section + .provider-form-section {
        margin-top: 2rem;
    }

    .provider-form-section h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.45rem;
        margin-bottom: 0.35rem;
    }

    .provider-form-section p {
        color: #5e7687;
        margin-bottom: 1.2rem;
    }

    .provider-form-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .provider-form-grid.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .provider-field {
        display: grid;
        gap: 0.45rem;
    }

    .provider-field.full {
        grid-column: 1 / -1;
    }

    .provider-field label {
        color: #355166;
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0;
    }

    .provider-field .form-control,
    .provider-field .form-select {
        background: #fbfdfe;
        border: 1px solid #d9e6ee;
        border-radius: 1rem;
        box-shadow: none;
        min-height: 3.35rem;
        padding: 0.8rem 1rem;
    }

    .provider-field .input-group-text {
        background: #eef5f8;
        border: 1px solid #d9e6ee;
        border-radius: 1rem 0 0 1rem;
        color: #35617c;
        min-width: 3.4rem;
        justify-content: center;
    }

    .provider-field .input-group .form-control {
        border-left: 0;
        border-radius: 0 1rem 1rem 0;
    }

    .provider-file-note {
        color: #6b8393;
        font-size: 0.85rem;
        margin: 0;
    }

    .provider-submit {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.75rem;
    }

    .provider-submit .btn {
        border-radius: 999px;
        padding: 0.8rem 1.5rem;
    }

    @media (max-width: 991.98px) {
        .provider-form-hero-grid,
        .provider-form-grid,
        .provider-form-grid.three {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .provider-form-hero,
        .provider-form-body {
            padding: 1.35rem;
        }
    }
</style>

<section class="provider-form-page">
    <div class="container">
        <div class="provider-form-shell">
            <div class="provider-form-card provider-form-hero">
                <div class="provider-form-hero-grid">
                    <div>
                        <p class="provider-form-eyebrow">Provider Details</p>
                        <h1>Complete your provider profile.</h1>
                        <p>Add your business details, upload a provider photo, and keep your license information ready before you start listing properties.</p>
                    </div>

                    <div class="provider-profile-card">
                        <img src="<%= profilePic %>" alt="Provider profile photo" id="profile-preview" class="provider-avatar">
                        <h2><%= userInfo.name %></h2>
                        <p>Property Provider</p>
                    </div>
                </div>
            </div>

            <div class="provider-form-card provider-form-body">
                <form
                    id="form"
                    method="post"
                    action="/provider/<%= userRoleID %>?_method=patch"
                    enctype="multipart/form-data"
                    class="validation-required"
                    novalidate
                    data-selected-state="<%= address.state || '' %>"
                    data-selected-city="<%= address.city || '' %>"
                >
                    <div class="provider-form-section">
                        <h2>Basic Information</h2>
                        <p>These details appear across your provider profile and dashboard.</p>
                        <div class="provider-form-grid">
                            <div class="provider-field">
                                <label for="name">Name</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-user"></i>
                                        </div>
                                    </div>
                                    <input id="name" name="name" type="text" class="form-control" value="<%= userInfo.name %>" readonly>
                                </div>
                            </div>

                            <div class="provider-field">
                                <label for="email">Email</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-link"></i>
                                        </div>
                                    </div>
                                    <input id="email" name="email" type="text" class="form-control" value="<%= userInfo.email %>" readonly>
                                </div>
                            </div>

                            <div class="provider-field">
                                <label for="phone">Phone</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">+91</div>
                                    </div>
                                    <input id="phone" name="phone" type="text" class="form-control" pattern="(7|8|9)\d{9}" required>
                                </div>
                            </div>

                            <div class="provider-field">
                                <label for="dob">Date of Birth</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-birthday-cake"></i>
                                        </div>
                                    </div>
                                    <input
                                        id="dob"
                                        name="dob"
                                        type="date"
                                        min="1980-01-01"
                                        max="<%= new Date(new Date().getFullYear() - 18, new Date().getMonth(), new Date().getDate()).toLocaleDateString('fr-ca') %>"
                                        class="form-control"
                                        value="<%= hasDob ? new Date(userInfo.dob.getFullYear(), userInfo.dob.getMonth(), userInfo.dob.getDate()).toLocaleDateString('fr-ca') : '' %>"
                                        required
                                    >
                                </div>
                            </div>

                            <div class="provider-field">
                                <label for="gst">GST Number</label>
                                <input
                                    id="gst"
                                    name="gst"
                                    type="text"
                                    class="form-control"
                                    pattern="[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}"
                                    placeholder="Enter GST number"
                                    required
                                >
                            </div>

                            <div class="provider-field">
                                <label for="profile-pic">Provider Photo</label>
                                <input id="profile-pic" name="profile-pic" type="file" class="form-control" accept=".png,.jpg,.jpeg" required>
                                <p class="provider-file-note">This photo will appear on your provider dashboard and profile menu.</p>
                            </div>
                        </div>
                    </div>

                    <div class="provider-form-section">
                        <h2>License Information</h2>
                        <p>Upload your license certificate and add the date until which it remains valid.</p>
                        <div class="provider-form-grid">
                            <div class="provider-field">
                                <label for="license-validity">License Certificate</label>
                                <input id="license-validity" name="license-validity" type="file" class="form-control" required>
                                <p class="provider-file-note">Any certificate file format is allowed.</p>
                            </div>

                            <div class="provider-field">
                                <label for="licenseValidUpto">License Valid Upto</label>
                                <input
                                    id="licenseValidUpto"
                                    name="licenseValidUpto"
                                    type="date"
                                    class="form-control"
                                    value="<%= hasLicenseDate ? new Date(userInfo.licenseValidUpto.getFullYear(), userInfo.licenseValidUpto.getMonth(), userInfo.licenseValidUpto.getDate()).toLocaleDateString('fr-ca') : '' %>"
                                    required
                                >
                            </div>
                        </div>
                    </div>

                    <div class="provider-form-section">
                        <h2>Address Details</h2>
                        <p>Add the business location details associated with your provider account.</p>
                        <div class="provider-form-grid three">
                            <div class="provider-field full">
                                <label for="addBuilding">Building Address</label>
                                <input id="addBuilding" name="addBuilding" type="text" class="form-control" value="<%= address.building || '' %>" required>
                            </div>

                            <div class="provider-field">
                                <label for="addL1">Address Line 1</label>
                                <input id="addL1" name="addL1" type="text" class="form-control" value="<%= address.addL1 || '' %>" required>
                            </div>

                            <div class="provider-field">
                                <label for="addL2">Address Line 2</label>
                                <input id="addL2" name="addL2" type="text" class="form-control" value="<%= address.addL2 || '' %>">
                            </div>

                            <div class="provider-field">
                                <label for="landmark">Landmark</label>
                                <input id="landmark" name="landmark" type="text" class="form-control" value="<%= address.landmark || '' %>" required>
                            </div>

                            <div class="provider-field">
                                <label for="state">State</label>
                                <select id="state" name="state" class="form-select" required>
                                    <option value="">Select state</option>
                                </select>
                            </div>

                            <div class="provider-field">
                                <label for="city">City</label>
                                <select id="city" name="city" class="form-select" required disabled>
                                    <option value="">Select city</option>
                                </select>
                            </div>

                            <div class="provider-field">
                                <label for="zipCode">Zip Code</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-location-arrow"></i>
                                        </div>
                                    </div>
                                    <input id="zipCode" name="zipCode" type="text" pattern="\d{6}" class="form-control" value="<%= address.zipcode || '' %>" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="provider-submit">
                        <button name="submit" type="submit" class="btn btn-primary">Save Details</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('form');
    const stateSelector = document.getElementById('state');
    const citySelector = document.getElementById('city');
    const profileInput = document.getElementById('profile-pic');
    const profilePreview = document.getElementById('profile-preview');
    const selectedState = form.dataset.selectedState || '';
    const selectedCity = form.dataset.selectedCity || '';

    async function fetchStates() {
        return fetch('/state-list').then((response) => response.json());
    }

    async function fetchCities(state) {
        return fetch(`/city/${state}`).then((response) => response.json());
    }

    function populateCities(cities, activeCity) {
        citySelector.innerHTML = '<option value="">Select city</option>';

        for (const city of cities) {
            const option = document.createElement('option');
            option.value = city;
            option.innerText = city;
            if (city === activeCity)
                option.selected = true;
            citySelector.appendChild(option);
        }

        if (cities.length > 0)
            citySelector.removeAttribute('disabled');
        else
            citySelector.setAttribute('disabled', 'true');
    }

    fetchStates().then((states) => {
        for (const state of states) {
            const option = document.createElement('option');
            option.value = state;
            option.innerText = state;
            if (state === selectedState)
                option.selected = true;
            stateSelector.appendChild(option);
        }

        if (selectedState)
            return fetchCities(selectedState).then((cities) => populateCities(cities, selectedCity));
    });

    stateSelector.addEventListener('change', (e) => {
        const value = e.target.value;

        if (!value) {
            populateCities([], '');
            return;
        }

        fetchCities(value).then((cities) => populateCities(cities, ''));
    });

    profileInput.addEventListener('change', () => {
        const [file] = profileInput.files;
        if (!file) return;

        profilePreview.src = URL.createObjectURL(file);
    });

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        if (!form.checkValidity())
            return;

        const formData = new FormData();
        const fields = [
            'name',
            'email',
            'phone',
            'dob',
            'gst',
            'licenseValidUpto',
            'addBuilding',
            'addL1',
            'addL2',
            'landmark',
            'state',
            'city',
            'zipCode'
        ];

        for (const field of fields) {
            const input = form.elements[field];
            if (input)
                formData.append(field, input.value || '');
        }

        if (profileInput.files[0])
            formData.append('profile-pic', profileInput.files[0]);

        const licenseInput = document.getElementById('license-validity');
        if (licenseInput.files[0])
            formData.append('license-validity', licenseInput.files[0]);

        axios({
            url: '/provider/<%= userRoleID %>?_method=patch',
            method: 'post',
            data: formData,
        })
            .then(() => {
                addFlash('success', 'Your data has been successfully updated!');
                setTimeout(() => {
                    window.location = '/provider/<%= userRoleID %>';
                }, 2000);
            })
            .catch((error) => {
                const errors = error.response?.data?.errors;
                if (errors && errors.length > 0) {
                    for (const err of errors)
                        addFlash('error', err.msg);
                    return;
                }

                const message = error.response?.data?.error || error.message || 'Could not update your profile.';
                addFlash('error', message);
            });
    });
</script>
