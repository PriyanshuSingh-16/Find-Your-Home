<!-- ADMIN REGISTRATION -->
<% layout('layout/boilerplate.ejs') -%>

<style>
    .auth-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        min-height: calc(100vh - 120px);
        padding: 1rem 0 4rem;
    }

    .auth-shell {
        align-items: stretch;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    }

    .auth-showcase,
    .auth-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.9rem;
        box-shadow: 0 1.4rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .auth-showcase {
        background:
            linear-gradient(150deg, rgba(255, 255, 255, 0.94) 0%, rgba(224, 239, 246, 0.9) 100%);
        padding: 2.4rem;
        position: relative;
    }

    .auth-showcase::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.45) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 18rem;
        position: absolute;
        right: -4rem;
        top: -4rem;
        width: 18rem;
    }

    .auth-showcase-content {
        position: relative;
        z-index: 1;
    }

    .auth-eyebrow {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.9rem;
        text-transform: uppercase;
    }

    .auth-showcase h1 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        font-style: italic;
        line-height: 1.12;
        margin-bottom: 1rem;
    }

    .auth-showcase p {
        color: #5e7687;
        line-height: 1.85;
        margin-bottom: 1rem;
    }

    .auth-points {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.4rem;
    }

    .auth-point {
        align-items: flex-start;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.1rem;
        display: flex;
        gap: 0.75rem;
        padding: 0.95rem 1rem;
    }

    .auth-point i {
        color: #2d7396;
        margin-top: 0.2rem;
    }

    .auth-point span {
        color: #4f6778;
        line-height: 1.7;
    }

    .auth-card {
        padding: 2rem;
    }

    .auth-card h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        margin-bottom: 0.35rem;
    }

    .auth-card-subtitle {
        color: #5e7687;
        margin-bottom: 1.4rem;
    }

    .auth-form {
        display: grid;
        gap: 1rem;
    }

    .auth-field {
        display: grid;
        gap: 0.45rem;
    }

    .auth-field label {
        color: #355166;
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }

    .auth-field .form-control {
        background: #fbfdfe;
        border: 1px solid #d9e6ee;
        border-radius: 1rem;
        box-shadow: none;
        min-height: 3.35rem;
        padding: 0.8rem 1rem;
    }

    .auth-actions .btn {
        border-radius: 999px;
        padding: 0.8rem 1.4rem;
    }

    @media (max-width: 991.98px) {
        .auth-shell {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .auth-showcase,
        .auth-card {
            padding: 1.35rem;
        }
    }
</style>

<section class="auth-page">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-showcase">
                <div class="auth-showcase-content">
                    <p class="auth-eyebrow">Admin Portal</p>
                    <h1>Register admin access with the provided validation key.</h1>
                    <p>If you are already a registered user, you can request admin access by entering your email and the valid admin key assigned for portal activation.</p>
                    <div class="auth-points">
                        <div class="auth-point">
                            <i class="fa-solid fa-user-shield"></i>
                            <span>Admin registration extends an existing user account with elevated platform permissions.</span>
                        </div>
                        <div class="auth-point">
                            <i class="fa-solid fa-key"></i>
                            <span>Only users with the correct admin validation key can complete this setup.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <h2>Admin Registration</h2>
                <p class="auth-card-subtitle">Enter your email and admin validation key to continue.</p>

                <form class="auth-form" action="/auth/admin-create" method="post" enctype="application/x-www-form-urlencoded">
                    <div class="auth-field">
                        <label class="form-label" for="email-input">Email address</label>
                        <input name="email" type="email" id="email-input" class="form-control" placeholder="Enter Email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$" required/>
                    </div>

                    <div class="auth-field">
                        <label class="form-label" for="key">Validation Key</label>
                        <input name="adminKey" type="password" id="key" class="form-control" placeholder="Enter Validation Key" required/>
                    </div>

                    <div class="auth-actions">
                        <button type="submit" class="btn btn-primary">Register Admin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
