    </section>

    <section id="help" class="contact-section section-block">
        <div class="container">
            <div class="contact-shell row g-0 align-items-stretch">
                <div class="col-lg-5">
                    <div class="contact-panel">
                        <p class="about-eyebrow mb-0">Contact Us</p>
                        <h3>Reach out when you need help choosing the right stay.</h3>
                        <p>Whether you have a booking question, need platform support, or want help narrowing your options, send a message and the team will get back to you.</p>
                        <img class="img-fluid" src="/images/contact.jpg" alt="Contact Us">
                    </div>
                </div>
                <div class="col-lg-7">
                    <form id='contact-form' action="/contact/" class="contact-form-wrap validation-required h-100" method="post" novalidate>
                        <div class="form-group mb-3">
                            <label for="email" class="col-form-label">Email</label>
                            <div class="col-12">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">
                                            <i class="fa fa-address-card"></i>
                                        </div>
                                    </div>
                                    <input id="email" name="email" placeholder="Enter email" type="email" class="form-control" pattern="^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label for="subject" class="col-form-label">Subject</label>
                            <div class="col-12">
                                <input id="subject" name="subject" placeholder="Enter subject" type="text" minlength="3" maxlength="100" class="form-control" required>
                            </div>
                        </div>
                        <div class="form-group mb-4">
                            <label for="content" class="col-form-label">Message</label>
                            <div class="col-12">
                                <textarea id="content" name="content" placeholder="Enter Message" minlength="20" maxlength="1000" class="form-control" rows="6" required></textarea>
                            </div>
                        </div>
                        <div class="form-group mb-0">
                            <div class="d-flex justify-content-start">
                                <button name="submit" type="submit" class="btn btn-primary contact-submit">Submit Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</section>

<script>
    const form = document.getElementById('contact-form');

	form.addEventListener('submit', e => {
		e.preventDefault();

		const formData = new URLSearchParams(new FormData(form));
		const url = '/contact/'

        const config = {
			url: url,
            data: formData.toString(),
            headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
            },
            method: 'post'
        }

		axios(config)
            .then(res => {
	            addFlash('success', 'Message sent successfully!');
            })
            .catch(error => {
	            console.log(error);
	            if (error.response.data.errors) {
		            const errors = error.response.data.errors;
		            for (let err of errors)
			            addFlash('error', err.msg);
	            }

	            else if (error.response.data.error)
		            addFlash('error', error.response.data.error);
            })
    })
</script>
