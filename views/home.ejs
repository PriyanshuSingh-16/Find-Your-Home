                            <p>A softer, simpler way to explore PGs and hostels across cities, compare the details that matter, and move toward booking with more confidence.</p>
                            <div class="hero-actions">
                                <a role='button' href="/property/search" class="btn btn-primary hero-primary-btn">Search PGs</a>
                                <span class="hero-inline-note">Search, compare, review, and book in one place.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6" data-aos="fade-left" data-aos-duration="1000">
                        <div class="hero-visual">
                            <div class="hero-visual-card">
                                <img src="/images/stayvista-logo.png" alt="StayVista logo" class="img-fluid">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="about-section">
        <div class="container">
            <div class="about-shell row g-0 align-items-stretch">
