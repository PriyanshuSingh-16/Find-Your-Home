<!-- SINGLE PROPERTY PAGE -->
<% layout('layout/boilerplate.ejs') -%>
<%
    const heroImage = (property.images && property.images[0]) || '/images/house-fallback.svg';
    const propertyType = property.type === 'co' ? 'Co-Living' : property.type === 'male' ? 'Male' : 'Female';
    const occupancyLabel = property.occupancy && property.occupancy.length > 0
        ? property.occupancy.map((v) => v.substring(0, 1).toUpperCase() + v.substring(1)).join(', ')
        : 'Not specified';
%>

<style>
    .property-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        padding: 1rem 0 4rem;
    }

    .property-shell {
        display: grid;
        gap: 1.5rem;
    }

    .property-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.8rem;
        box-shadow: 0 1.3rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .property-hero {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(228, 241, 247, 0.96) 100%);
        padding: 2.2rem;
        position: relative;
    }

    .property-hero::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.42) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 18rem;
        position: absolute;
        right: -5rem;
        top: -5rem;
        width: 18rem;
    }

    .property-hero-grid {
        align-items: stretch;
        display: grid;
        gap: 1.6rem;
        grid-template-columns: minmax(320px, 1.1fr) minmax(0, 1fr);
        position: relative;
        z-index: 1;
    }

    .property-media {
        display: grid;
        gap: 0.9rem;
    }

    .property-main-image {
        aspect-ratio: 4 / 3;
        border-radius: 1.6rem;
        object-fit: cover;
        width: 100%;
    }

    .property-gallery {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding: 0.5rem 0;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .property-gallery::-webkit-scrollbar {
        height: 0.35rem;
    }

    .property-gallery::-webkit-scrollbar-track {
        background: rgba(76, 134, 168, 0.08);
        border-radius: 999px;
    }

    .property-gallery::-webkit-scrollbar-thumb {
        background: rgba(76, 134, 168, 0.24);
        border-radius: 999px;
    }

    .property-gallery::-webkit-scrollbar-thumb:hover {
        background: rgba(76, 134, 168, 0.4);
    }

    .property-gallery a {
        display: block;
        flex-shrink: 0;
        text-decoration: none;
        width: 100px;
        height: 100px;
    }

    .property-gallery img {
        aspect-ratio: 1;
        border-radius: 1rem;
        object-fit: cover;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .property-gallery img:hover {
        box-shadow: 0 0.4rem 1rem rgba(31, 56, 88, 0.15);
        transform: scale(1.02);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .property-copy p:first-child,
    .property-section-head p:first-child {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
    }

    .property-copy h1,
    .property-section-head h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        font-style: italic;
        line-height: 1.1;
        margin-bottom: 0.7rem;
    }

    .property-copy .property-address {
        color: #456174;
        font-size: 1.02rem;
        margin-bottom: 0.6rem;
    }

    .property-copy .property-tagline {
        color: #688091;
        font-size: 1.02rem;
        font-style: italic;
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .property-copy .property-description {
        color: #5e7687;
        line-height: 1.85;
        margin-bottom: 1.2rem;
    }

    .property-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-bottom: 1.2rem;
    }

    .property-pill {
        background: rgba(45, 115, 150, 0.12);
        border-radius: 999px;
        color: #2d7396;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.55rem 0.85rem;
    }

    .property-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }

    .property-actions .btn {
        border-radius: 999px;
        padding: 0.78rem 1.35rem;
    }

    .property-like-btn {
        min-width: 3.3rem;
    }

    .property-stats-panel,
    .property-details-panel,
    .property-review-panel,
    .property-about-panel {
        padding: 2rem;
    }

    .property-stats-grid,
    .property-details-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .property-stat,
    .property-detail-item {
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.2rem;
        padding: 1rem;
    }

    .property-stat span,
    .property-detail-item span {
        color: #6b8393;
        display: block;
        font-size: 0.84rem;
        margin-bottom: 0.3rem;
    }

    .property-stat strong,
    .property-detail-item strong {
        color: #17344b;
        font-size: 1.02rem;
    }

    .property-location-link {
        margin-top: 1rem;
    }

    .property-location-link .btn {
        border-radius: 999px;
    }

    .property-section-head {
        margin-bottom: 1.4rem;
    }

    .property-about-grid {
        display: grid;
        gap: 1.2rem;
    }

    .property-about-card {
        background: rgba(255, 255, 255, 0.98);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.5rem;
        box-shadow: 0 1rem 2.2rem rgba(31, 56, 88, 0.06);
        padding: 1.3rem;
    }

    .property-about-card h3 {
        color: #17344b;
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .property-feature-grid {
        display: grid;
        gap: 0.9rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .property-feature-item {
        align-items: center;
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.1rem;
        display: grid;
        gap: 0.8rem;
        grid-template-columns: 56px 1fr;
        min-height: 100%;
        padding: 0.9rem;
    }

    .property-feature-item img {
        aspect-ratio: 1;
        object-fit: contain;
        width: 56px;
    }

    .property-feature-item strong {
        color: #17344b;
        display: block;
        font-size: 0.95rem;
        margin-bottom: 0.18rem;
        text-transform: capitalize;
    }

    .property-feature-item span {
        color: #647d8e;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .property-rule-icon {
        font-size: 1.25rem;
    }

    .property-videos-section {
        margin-top: 1.5rem;
    }

    .property-videos-label {
        color: #4c86a8;
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
    }

    .property-videos-gallery {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding: 0.5rem 0;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .property-videos-gallery::-webkit-scrollbar {
        height: 0.35rem;
    }

    .property-videos-gallery::-webkit-scrollbar-track {
        background: rgba(76, 134, 168, 0.08);
        border-radius: 999px;
    }

    .property-videos-gallery::-webkit-scrollbar-thumb {
        background: rgba(76, 134, 168, 0.24);
        border-radius: 999px;
    }

    .property-videos-gallery::-webkit-scrollbar-thumb:hover {
        background: rgba(76, 134, 168, 0.4);
    }

    .property-video-item {
        flex-shrink: 0;
        position: relative;
        width: 140px;
        height: 100px;
    }

    .property-video-item video {
        border-radius: 1rem;
        cursor: pointer;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .property-video-item video:hover {
        box-shadow: 0 0.4rem 1rem rgba(31, 56, 88, 0.15);
        transform: scale(1.02);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .property-video-item::after {
        align-items: center;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 1rem;
        content: '';
        display: flex;
        height: 100%;
        justify-content: center;
        left: 0;
        opacity: 0;
        position: absolute;
        top: 0;
        transition: opacity 0.2s ease;
        width: 100%;
    }

    .property-video-item:hover::after {
        opacity: 1;
    }

    .property-video-play-icon {
        color: white;
        font-size: 2rem;
        left: 50%;
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
    }

    .property-review-form {
        background: rgba(245, 250, 252, 0.92);
        border: 1px solid rgba(76, 134, 168, 0.14);
        border-radius: 1.4rem;
        padding: 1rem;
        margin-bottom: 1.4rem;
    }

    .property-review-form .input-group {
        margin-top: 0.85rem;
    }

    .property-review-form .form-control,
    .property-review-form .btn {
        min-height: 3rem;
    }

    .property-review-list {
        display: grid;
        gap: 1rem;
    }

    .property-review-item {
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.25rem;
        overflow: hidden;
    }

    .property-review-head {
        align-items: center;
        background: rgba(45, 115, 150, 0.08);
        color: #365a70;
        display: flex;
        flex-wrap: wrap;
        font-size: 0.9rem;
        gap: 0.6rem;
        justify-content: space-between;
        padding: 0.85rem 1rem;
    }

    .property-review-body {
        padding: 1rem;
    }

    .property-review-body p {
        color: #506a7c;
        line-height: 1.8;
        margin: 0 0 0.8rem;
    }

    .property-empty {
        background: rgba(248, 251, 253, 0.95);
        border: 1px dashed rgba(76, 134, 168, 0.22);
        border-radius: 1.4rem;
        color: #5f7788;
        padding: 1.35rem;
        text-align: center;
    }

    @media (max-width: 991.98px) {
        .property-hero-grid {
            grid-template-columns: 1fr;
        }

        .property-hero,
        .property-stats-panel,
        .property-details-panel,
        .property-review-panel,
        .property-about-panel {
            padding: 1.4rem;
        }
    }

    @media (max-width: 767.98px) {
        .property-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .property-actions .btn {
            width: 100%;
        }
    }
</style>

<section class="property-page">
    <div class="container">
        <div class="property-shell">
            <div class="property-card property-hero">
                <div class="property-hero-grid">
                    <div class="property-media">
                        <img class="property-main-image" src="<%= heroImage %>" alt="<%= property.name %>">

                        <% if (property.images && property.images.length > 0) { %>
                            <div id="gallery" class="property-gallery">
                                <% for (let i = 0; i < property.images.length; i++) { %>
                                    <a href="<%= property.images[i] %>">
                                        <img src="<%= property.images[i] %>" alt="property-image">
                                    </a>
                                <% } %>
                            </div>
                        <% } %>

                        <% if (property.videos && property.videos.length > 0) { %>
                            <div class="property-videos-section">
                                <span class="property-videos-label">Videos</span>
                                <div class="property-videos-gallery">
                                    <% for (let i = 0; i < property.videos.length; i++) { %>
                                        <div class="property-video-item" onclick="playVideo('<%= property.videos[i] %>')">
                                            <video preload="metadata" poster="<%= property.images && property.images[0] %>">
                                                <source src="<%= property.videos[i] %>" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                            <i class="fa-solid fa-play property-video-play-icon"></i>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <div class="property-copy">
                        <p>Property Details</p>
                        <h1><%= property.name %></h1>
                        <div class="property-address"><%= property.address.addL1 %>, <%= property.address.city %>, <%= property.address.state %></div>
                        <div class="property-tagline"><%= property.tagline %></div>
                        <p class="property-description"><%= property.desc %></p>

                        <div class="property-pill-row">
                            <span class="property-pill"><%= propertyType %></span>
                            <span class="property-pill">₹ <%= property.rate %> / month</span>
                            <span class="property-pill"><%= property.maxOcc %> max occupancy</span>
                            <span class="property-pill"><%= property.availableRooms || property.maxOcc || 0 %> rooms available</span>
                            <span class="property-pill"><%= property.since %> onwards</span>
                        </div>

                        <div class="property-actions">
                            <button class="btn btn-primary btn-lg" onclick="startBookingFlow()" <%= user && user.role === 'rider' ? '' : 'disabled' %>>Book Now</button>
                            <% if (user && user.role === 'rider') { %>
                                <a class="btn btn-outline-success btn-lg" href="/messages/property/<%= property._id %>">Contact Owner</a>
                            <% } else if (!user) { %>
                                <a class="btn btn-outline-success btn-lg" href="/auth/login">Login To Contact Owner</a>
                            <% } else if (user.role === 'provider' && userDet.id === property.owner.id) { %>
                                <a class="btn btn-outline-success btn-lg" href="/messages">Open Inbox</a>
                            <% } %>
                            <% if (property.exactLocationLink) { %>
                                <a class="btn btn-outline-primary btn-lg" href="<%= property.exactLocationLink %>" target="_blank" rel="noopener noreferrer">Open Map Pin</a>
                            <% } %>
                            <% if (user) { %>
                                <% if (user.role === 'rider') { %>
                                    <button id="like-button" class="btn btn-outline-danger btn-lg property-like-btn" onclick="toggleLike()">
                                        <i class="<%= userDet.likes.includes(property.id) ? 'fa-solid' : 'fa-regular' %> fa-heart" style="color: red"></i>
                                    </button>
                                <% } else if (user.role === 'provider' && userDet.id === property.owner.id) { %>
                                    <a href="/property/<%= property._id %>/edit" role="button" class="btn btn-outline-secondary btn-lg">Edit Property</a>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="property-card property-stats-panel">
                <div class="property-stats-grid">
                    <div class="property-stat">
                        <span>Owner</span>
                        <strong><%= property.owner.name %></strong>
                    </div>
                    <div class="property-stat">
                        <span>Rate</span>
                        <strong>₹ <%= property.rate %> / month</strong>
                    </div>
                    <div class="property-stat">
                        <span>Booking Amount</span>
                        <strong>₹ <%= property.bookingMoney %></strong>
                    </div>
                    <div class="property-stat">
                        <span>Rooms Available</span>
                        <strong><%= property.availableRooms || property.maxOcc || 0 %></strong>
                    </div>
                    <div class="property-stat">
                        <span>Rating</span>
                        <strong id="rating-stars"><%= property.rating %></strong>
                    </div>
                    <div class="property-stat">
                        <span>Occupancy</span>
                        <strong><%= occupancyLabel %></strong>
                    </div>
                    <div class="property-stat">
                        <span>Property Type</span>
                        <strong><%= propertyType %></strong>
                    </div>
                </div>

                <% if (property.exactLocationLink) { %>
                    <div class="property-location-link">
                        <a class="btn btn-outline-primary" href="<%= property.exactLocationLink %>" target="_blank" rel="noopener noreferrer">Open exact location in Google Maps</a>
                    </div>
                <% } %>
            </div>

            <div class="property-card property-about-panel">
                <div class="property-section-head">
                    <p>Stay Snapshot</p>
                    <h2>What this PG offers.</h2>
                </div>

                <div class="property-about-grid">
                    <div class="property-about-card">
                        <h3>Food Related Details</h3>
                        <% if (property.food && property.food.length > 0) { %>
                            <div class="property-feature-grid">
                                <% for (let det of property.food) { %>
                                    <div class="property-feature-item">
                                        <img src="/<%= det.path %>.svg" alt="<%= det.name %>">
                                        <div>
                                            <strong><%= det.name && det.name.replace('-', ' ') %></strong>
                                            <span><%= det.detail || 'Available' %></span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="property-empty">No food-related details added for this property yet.</div>
                        <% } %>
                    </div>

                    <div class="property-about-card">
                        <h3>Amenities</h3>
                        <% if (property.amenities && property.amenities.length > 0) { %>
                            <div class="property-feature-grid">
                                <% for (let det of property.amenities) { %>
                                    <div class="property-feature-item">
                                        <img src="/<%= det.path %>.svg" alt="<%= det.name %>">
                                        <div>
                                            <strong><%= det.name && det.name.replace('-', ' ') %></strong>
                                            <span>Included in the stay</span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="property-empty">No amenities have been listed yet.</div>
                        <% } %>
                    </div>

                    <div class="property-about-card">
                        <h3>House Rules</h3>
                        <% if (property.rules && property.rules.length > 0) { %>
                            <div class="property-feature-grid">
                                <% for (let det of property.rules) { %>
                                    <div class="property-feature-item">
                                        <img src="/<%= det.path %>.svg" alt="<%= det.name %>">
                                        <div>
                                            <strong><%= det.name && det.name.replace(/-/g, ' ') %></strong>
                                            <span>
                                                <% if (det.allowed) { %>
                                                    <i class="fa-solid fa-circle-check property-rule-icon" style="color: lightgreen;"></i> Allowed
                                                <% } else { %>
                                                    <i class="fa-solid fa-circle-xmark property-rule-icon" style="color: crimson;"></i> Not allowed
                                                <% } %>
                                            </span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="property-empty">No house rules have been listed yet.</div>
                        <% } %>
                    </div>

                    <div class="property-about-card">
                        <h3>Other Charges and Details</h3>
                        <% if (property.otherCharges && property.otherCharges.length > 0) { %>
                            <div class="property-feature-grid">
                                <% for (let det of property.otherCharges) { %>
                                    <div class="property-feature-item">
                                        <img src="/<%= det.path !== 'undefined' ? det.path : 'blank' %>.svg" alt="<%= det.name %>">
                                        <div>
                                            <strong><%= det.name && det.name.replace(/-/g, ' ') %></strong>
                                            <span><%= det.detail || 'Details available on request' %></span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="property-empty">No extra charges or operational notes have been listed.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="property-card property-details-panel">
                <div class="property-section-head">
                    <p>Structured Overview</p>
                    <h2>Property information at a glance.</h2>
                </div>

                <div class="property-details-grid">
                    <div class="property-detail-item">
                        <span>Name</span>
                        <strong><%= property.name %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Owner</span>
                        <strong><%= property.owner.name %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Property Type</span>
                        <strong><%= propertyType %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Max Occupancy</span>
                        <strong><%= property.maxOcc %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Since</span>
                        <strong><%= property.since %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Beds</span>
                        <strong><%= occupancyLabel %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Booking Amount</span>
                        <strong>₹ <%= property.bookingMoney %></strong>
                    </div>
                    <div class="property-detail-item">
                        <span>Address</span>
                        <strong>
                            <%= property.address.building %>,
                            <%= property.address.addL1 %><%= property.address.addL2 ? `, ${property.address.addL2}` : '' %>,
                            <%= property.address.city %>, <%= property.address.state %> - <%= property.address.zipcode %>
                        </strong>
                    </div>
                </div>
            </div>

            <div class="property-card property-review-panel">
                <div class="property-section-head">
                    <p>Reviews</p>
                    <h2>What recent residents are saying.</h2>
                </div>

                <% if (user && user.role === 'rider') { %>
                    <div class="property-review-form">
                        <form action="" method="post" id="review-form" class="validation-required" novalidate>
                            <div class="d-flex align-items-center column-gap-2 flex-wrap row-gap-2">
                                <label for="review-stars" class="h5 mb-0" style="width: fit-content">Give Rating:</label>
                                <fieldset id="review-stars" class="starability-growRotate mt-2 w-auto" style="min-height: unset">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="rating" value="1" required />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="rating" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="rating" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="rating" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="rating" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div class="input-group shadow-lg">
                                <input type="text" name="comment" placeholder="Enter your review" class="form-control border-0" maxlength="1500" minlength="10" required />
                                <button type="submit" class="btn btn-primary border-0">Submit</button>
                            </div>
                        </form>
                    </div>
                <% } %>

                <% if (property.reviews && property.reviews.length > 0) { %>
                    <div class="property-review-list">
                        <% for (let review of property.reviews) { %>
                            <div class="property-review-item">
                                <div class="property-review-head">
                                    <span>By <strong><%= review.userID.name %></strong></span>
                                    <span><%= review.date.toLocaleDateString('en-US', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
                                    <span><%= review.rating %>⭐</span>
                                </div>
                                <div class="property-review-body">
                                    <p><%= review.comment %></p>
                                    <% if (userRoleID === review.userID.id) { %>
                                        <button class="btn btn-outline-danger btn-sm" onclick="deleteReview('<%= review.id %>')">Delete</button>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="property-empty">No reviews yet. Be the first to share your stay experience.</div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<script type="module">
    import PhotoSwipeLightbox from '/js/photoswipe.js';
    const gallery = document.getElementById('gallery');
    if (gallery) {
        const lightbox = new PhotoSwipeLightbox({
            gallery: '#gallery',
            children: 'a',
            initialZoomLevel: 'fit',
            pswpModule: () => import('/js/photoswipe.esm.js')
        });
        lightbox.init();
    }
</script>

<script>
    const likeButton = document.getElementById('like-button');

    function toggleLike() {
        const url = '/property/<%= property._id %>/toggle';

        axios({
            url: url,
            method: 'post',
        })
            .then((res) => {
                addFlash('success', `${res.data.state ? 'Added to' : 'Removed from'} your favourites successfully!`);

                const isLiked = !res.data.state;
                if (isLiked) {
                    likeButton.children.item(0).classList.remove('fa-solid');
                    likeButton.children.item(0).classList.add('fa-regular');
                } else {
                    likeButton.children.item(0).classList.remove('fa-regular');
                    likeButton.children.item(0).classList.add('fa-solid');
                }
            })
            .catch((err) => {
                addFlash('error', `Request failed due to : ${err.response?.data?.error || err}`);
            });
    }

    function getStars(rating) {
        let i;
        rating = Math.round(rating * 2) / 2;
        const output = [];

        for (i = rating; i >= 1; i--)
            output.push('<i class="fa fa-star" aria-hidden="true" style="color: gold;"></i>&nbsp;');

        if (i === 0.5)
            output.push('<i class="fa fa-star-half-o" aria-hidden="true" style="color: gold;"></i>&nbsp;');

        for (let j = (5 - rating); j >= 1; j--)
            output.push('<i class="fa fa-star-o" aria-hidden="true" style="color: gold;"></i>&nbsp;');

        return output.join('');
    }

    const ratingSection = document.getElementById('rating-stars');
    if (ratingSection)
        ratingSection.innerHTML = getStars(<%= property.rating %>);

    const reviewForm = document.getElementById('review-form');
    if (reviewForm) {
        reviewForm.addEventListener('submit', (e) => {
            e.preventDefault();

            if (!reviewForm.checkValidity())
                return;

            const formData = new URLSearchParams(new FormData(reviewForm));
            const url = '/review?propertyID=<%= property._id %>';

            axios({
                url: url,
                method: 'post',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                data: formData.toString()
            })
                .then(() => {
                    addFlash('success', 'Your review has been added successfully!');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                })
                .catch(() => {
                    addFlash('error', 'Couldn\'t post your review, there was some issue.');
                });
        });
    }

    function deleteReview(reviewId) {
        const url = '/review/' + reviewId + '?_method=delete';

        axios({
            url: url,
            method: 'post',
        })
            .then((res) => {
                if (res.headers['content-type'] === 'text/html; charset=utf-8')
                    throw new Error('Please Login First!');

                addFlash('success', res.data.success);
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            })
            .catch((err) => {
                addFlash('error', err.response?.data?.error || err || 'Review could not be deleted!');
            });
    }

    function startBookingFlow() {
        window.location = '/booking/<%= property._id %>/new';
    }

    function playVideo(videoUrl) {
        // Create a simple modal for video playback
        const videoModal = document.createElement('div');
        videoModal.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            cursor: pointer;
        `;

        const videoElement = document.createElement('video');
        videoElement.style.cssText = `
            max-width: 90vw;
            max-height: 90vh;
            border-radius: 0.8rem;
            object-fit: contain;
        `;
        videoElement.controls = true;
        videoElement.autoplay = true;
        videoElement.src = videoUrl;

        videoModal.appendChild(videoElement);
        videoModal.onclick = (e) => {
            if (e.target === videoModal) {
                videoModal.remove();
            }
        };

        document.body.appendChild(videoModal);
    }
</script>
