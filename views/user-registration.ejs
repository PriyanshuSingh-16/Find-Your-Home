<!-- USER REGISTRATION -->
<% layout('layout/boilerplate.ejs') -%>

<style>
    .auth-page {
        background: linear-gradient(180deg, #f5fafc 0%, #eef4f7 100%);
        min-height: calc(100vh - 120px);
        padding: 1rem 0 4rem;
    }

    .auth-shell {
        align-items: stretch;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    }

    .auth-showcase,
    .auth-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 1.9rem;
        box-shadow: 0 1.4rem 2.8rem rgba(31, 56, 88, 0.08);
        overflow: hidden;
    }

    .auth-showcase {
        background:
            linear-gradient(150deg, rgba(255, 255, 255, 0.94) 0%, rgba(224, 239, 246, 0.9) 100%);
        padding: 2.4rem;
        position: relative;
    }

    .auth-showcase::before {
        background: radial-gradient(circle, rgba(186, 220, 235, 0.45) 0%, rgba(186, 220, 235, 0) 72%);
        content: '';
        height: 18rem;
        position: absolute;
        right: -4rem;
        top: -4rem;
        width: 18rem;
    }

    .auth-showcase-content {
        position: relative;
        z-index: 1;
    }

    .auth-eyebrow {
        color: #4c86a8;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        margin-bottom: 0.9rem;
        text-transform: uppercase;
    }

    .auth-showcase h1 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        font-style: italic;
        line-height: 1.12;
        margin-bottom: 1rem;
    }

    .auth-showcase p {
        color: #5e7687;
        line-height: 1.85;
        margin-bottom: 1rem;
    }

    .auth-points {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.4rem;
    }

    .auth-point {
        align-items: flex-start;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(76, 134, 168, 0.12);
        border-radius: 1.1rem;
        display: flex;
        gap: 0.75rem;
        padding: 0.95rem 1rem;
    }

    .auth-point i {
        color: #2d7396;
        margin-top: 0.2rem;
    }

    .auth-point span {
        color: #4f6778;
        line-height: 1.7;
    }

    .auth-card {
        padding: 2rem;
    }

    .auth-card h2 {
        color: #163247;
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        margin-bottom: 0.35rem;
    }

    .auth-card-subtitle {
        color: #5e7687;
        margin-bottom: 1.4rem;
    }

    .auth-form {
        display: grid;
        gap: 1rem;
    }

    .auth-field {
        display: grid;
        gap: 0.45rem;
    }

    .auth-field label,
    .auth-role-group > span {
        color: #355166;
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }

    .auth-field .form-control {
        background: #fbfdfe;
        border: 1px solid #d9e6ee;
        border-radius: 1rem;
        flex: 1 1 auto;
        box-shadow: none;
        min-height: 3.35rem;
        padding: 0.8rem 1rem;
        width: 1%;
    }

    .auth-field .input-group {
        align-items: stretch;
        flex-wrap: nowrap;
    }

    .auth-field .input-group-prepend,
    .auth-field .input-group-append {
        display: flex;
    }

    .auth-field .input-group-text {
        align-items: center;
        background: #eef5f8;
        border: 1px solid #d9e6ee;
        color: #35617c;
        display: flex;
        justify-content: center;
        min-width: 5.2rem;
    }

    .auth-field .input-group-text:first-child {
        border-radius: 1rem 0 0 1rem;
    }

    .auth-field .input-group-text:last-child {
        border-left: 0;
        border-radius: 0 1rem 1rem 0;
        cursor: pointer;
    }

    .auth-field .input-group .form-control {
        border-left: 0;
        border-radius: 0;
        min-width: 0;
    }

    .auth-help {
        color: #6b8191;
        font-size: 0.85rem;
        line-height: 1.65;
        margin: 0;
    }

    .auth-role-group {
        display: grid;
        gap: 0.75rem;
    }

    .auth-role-options {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .auth-role-chip {
        align-items: center;
        background: #f8fbfd;
        border: 1px solid rgba(76, 134, 168, 0.14);
        border-radius: 999px;
        display: inline-flex;
        gap: 0.5rem;
        min-width: 140px;
        padding: 0.75rem 1rem;
    }

    .auth-role-chip .form-check-input {
        margin: 0;
        position: static;
    }

    .auth-role-chip label {
        color: #4f6778;
        font-weight: 500;
        margin: 0;
    }

    .auth-actions {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.35rem;
    }

    .auth-actions .btn {
        border-radius: 999px;
        padding: 0.8rem 1.4rem;
    }

    .auth-links {
        display: grid;
        gap: 0.65rem;
        margin-top: 1rem;
    }

    .auth-links a {
        color: #2d7396;
        text-decoration: none;
    }

    .auth-links a:hover,
    .auth-links a:focus {
        text-decoration: underline;
    }

    @media (max-width: 991.98px) {
        .auth-shell {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .auth-showcase,
        .auth-card {
            padding: 1.35rem;
        }

        .auth-actions {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<section class="auth-page">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-showcase">
                <div class="auth-showcase-content">
                    <p class="auth-eyebrow">PG Finder</p>
                    <h1>Create your account and start with the right role.</h1>
                    <p>Register once, verify your email, and continue either as a rider searching for stays or as a provider listing your own properties.</p>
                    <div class="auth-points">
                        <div class="auth-point">
                            <i class="fa-solid fa-user-check"></i>
                            <span>Keep one account to manage searches, bookings, and your profile details.</span>
                        </div>
                        <div class="auth-point">
                            <i class="fa-solid fa-building"></i>
                            <span>Choose provider if you want to post and manage PG listings of your own.</span>
                        </div>
                        <div class="auth-point">
                            <i class="fa-solid fa-envelope-circle-check"></i>
                            <span>Your account activation continues through email verification after signup.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <h2>Registration</h2>
                <p class="auth-card-subtitle">Fill in your account details and choose your role.</p>

                <form id='reg-form' action="/auth/registration" method="post" class="auth-form validation-required" novalidate>
                    <div class="auth-field">
                        <label for="name">Name</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <i class="fa fa-id-card-o"></i>
                                </div>
                            </div>
                            <input id="name" name="name" placeholder="Enter Name" type="text" class="form-control" required="required">
                        </div>
                    </div>

                    <div class="auth-field">
                        <label for="email">Email</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <i class="fa fa-link"></i>
                                </div>
                            </div>
                            <input id="email" name="email" placeholder="Enter Email" type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$" class="form-control" required="required">
                        </div>
                    </div>

                    <div class="auth-field">
                        <label for="pass">Password</label>
                        <div class="input-group">
                            <input id="pass" name="pass" placeholder="Enter Password" type="password" required="required" class="form-control" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*_=+-]).{8,12}$">
                            <div class="input-group-append">
                                <div class="input-group-text" onclick="toggleVisibility()">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </div>
                        </div>
                        <p class="auth-help">Minimum 8 characters with one uppercase letter, one number, and one special character.</p>
                    </div>

                    <div class="auth-role-group">
                        <span>Role</span>
                        <div class="auth-role-options">
                            <div class="auth-role-chip">
                                <input name="role" id="role_0" type="radio" class="form-check-input" value="rider" required="required" aria-describedby="roleHelpBlock">
                                <label for="role_0">Rider</label>
                            </div>
                            <div class="auth-role-chip">
                                <input name="role" id="role_1" type="radio" class="form-check-input" value="provider" required="required" aria-describedby="roleHelpBlock">
                                <label for="role_1">Provider</label>
                            </div>
                        </div>
                        <p id="roleHelpBlock" class="auth-help">Rider: you want to search for properties. Provider: you want to post and manage your own properties.</p>
                    </div>

                    <div class="auth-actions">
                        <button name="submit" type="submit" class="btn btn-primary">Create Account</button>
                    </div>

                    <div class="auth-links">
                        <a href="/auth/login">Already a user? Login.</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    const pass = document.getElementById('pass');
    function toggleVisibility() {
		if (pass.type === 'password')
			pass.type = 'text';
		else
			pass.type = 'password';
    }

	const form = document.getElementById('reg-form');

	form.addEventListener('submit', e => {
		e.preventDefault();

		const formData = new URLSearchParams(new FormData(form));
		const url = '/auth/registration';

		const config = {
			url: url,
            method: 'post',
            headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
            },
            data: formData.toString()
        };

		axios(config)
            .then((res) => {
				addFlash('success', 'Check your email to validate your account!');
				setTimeout(() => {
					window.location = '/auth/login';
                }, 5000);
            })
            .catch((error) => {
	            console.log(error);
				if (error.response.data.errors) {
					const errors = error.response.data.errors;
					for (let err of errors)
						addFlash('error', err.msg);
				}

				else if (error.response.data.error)
					addFlash('error', error.response.data.error);
            });
    });
</script>
